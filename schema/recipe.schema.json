{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["services"],
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceName", "actions"],
        "properties": {
          "serviceName": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "actionType"],
              "properties": {
                "step": {"type": "integer", "minimum": 1},
                "description": {"type": "string"},
                "actionType": {
                  "type": "string",
                  "enum": [
                    "Navigate",
                    "SwitchToParentFrame",
                    "SwitchToDefaultFrame",
                    "SwitchToFrame",
                    "Click",
                    "ClickUntilAbsent",
                    "ClickShadow",
                    "SendKeys",
                    "Download",
                    "DownloadAll"
                  ]
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "locators": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["locatorType", "element"],
                        "properties": {
                          "locatorType": {
                            "type": "string",
                            "enum": [
                              "ID",
                              "CSS_SELECTOR",
                              "XPATH",
                              "LINK_TEXT"
                            ]
                          },
                          "element": {"type": "string"}
                        }
                      }
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "variable": {
                      "type": "string",
                      "enum": [
                        "{USERNAME}",
                        "{PASSWORD}",
                        "{OTP}",
                        "ENTER"
                      ]
                    },
                    "timeout": {"type": "integer", "minimum": 1},
                    "maxClicks": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "graceful": {"type": "boolean"}
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "actionType": {"const": "Navigate"}
                    }
                  },
                  "then": {
                    "properties": {
                      "parameters": {"required": ["url"]}
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "actionType": {
                        "enum": [
                          "SwitchToParentFrame",
                          "SwitchToDefaultFrame"
                        ]
                      }
                    }
                  },
                  "else": {"required": ["parameters"]}
                },
                {
                  "if": {
                    "properties": {
                      "actionType": {"const": "ClickUntilAbsent"}
                    }
                  },
                  "then": {
                    "properties": {
                      "parameters": {
                        "required": ["locators"],
                        "properties": {
                          "locators": {"minItems": 2, "maxItems": 2}
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
