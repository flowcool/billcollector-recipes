{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "engine",
    "engineRevision",
    "status",
    "coverage",
    "limitations",
    "validation"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "const": "playwright-daemon"
    },
    "engineRevision": {
      "enum": [
        "45e530b7d6240abb308810183dbe4f65aae5b6dc",
        "c87f980b985d526dac95760e477cec95f280896d"
      ]
    },
    "status": {
      "enum": [
        "experimental",
        "qualified"
      ]
    },
    "coverage": {
      "enum": [
        "single-payment-schedule",
        "first-listed-document",
        "all-available-invoices",
        "offered-operation-notices"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "realProvider"
      ],
      "properties": {
        "synthetic": {
          "enum": [
            "tests/engine_probe.py",
            "tests/unattended_engine_probe.py",
            "tests/bourse_direct_engine_probe.py"
          ]
        },
        "realProvider": {
          "enum": [
            "not-run",
            "two-pass-qualified",
            "blocked-repeat-new-files",
            "blocked-pagination",
            "blocked-no-invoices",
            "blocked-download-transport",
            "blocked-zip-packaging"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "expectedDocuments": {
          "type": "integer",
          "minimum": 1
        },
        "firstRunNew": {
          "type": "integer",
          "minimum": 1
        },
        "repeatRunNew": {
          "type": "integer",
          "minimum": 0
        },
        "recipeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firstRunPdfReadback": {
          "type": "integer",
          "minimum": 0
        },
        "firstRunClicks": {
          "type": "integer",
          "minimum": 0
        },
        "firstRunDownloadEvents": {
          "type": "integer",
          "minimum": 0
        },
        "repeatRunClicks": {
          "type": "integer",
          "minimum": 0
        },
        "repeatRunDownloadEvents": {
          "type": "integer",
          "minimum": 0
        },
        "keySetsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independentSessions": {
          "const": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "history",
        "stableKey",
        "limits",
        "evidence"
      ],
      "properties": {
        "families": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_notices",
            "statements",
            "tax_documents",
            "other_documents"
          ],
          "properties": {
            "operation_notices": {
              "$ref": "#/definitions/scopeFamily"
            },
            "statements": {
              "$ref": "#/definitions/scopeFamily"
            },
            "tax_documents": {
              "$ref": "#/definitions/scopeFamily"
            },
            "other_documents": {
              "$ref": "#/definitions/scopeFamily"
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxMonths",
            "incrementalWindow",
            "controlRunRequired"
          ],
          "properties": {
            "maxMonths": {
              "const": 13
            },
            "incrementalWindow": {
              "type": "string",
              "minLength": 1
            },
            "observedOldestMonth": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            },
            "controlRunRequired": {
              "const": true
            }
          }
        },
        "stableKey": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "required": [
              "date",
              "expectedDocuments",
              "firstRunNew",
              "repeatRunNew",
              "recipeSha256",
              "firstRunPdfReadback",
              "firstRunClicks",
              "firstRunDownloadEvents",
              "repeatRunClicks",
              "repeatRunDownloadEvents",
              "keySetsSha256",
              "independentSessions"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service": {
            "const": "bourse_direct"
          }
        },
        "required": [
          "service"
        ]
      },
      "then": {
        "required": [
          "scope"
        ]
      }
    }
  ],
  "definitions": {
    "scopeFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "availability",
        "reason",
        "extension"
      ],
      "properties": {
        "status": {
          "enum": [
            "implemented",
            "documented"
          ]
        },
        "availability": {
          "enum": [
            "observed",
            "unverified"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
