{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "engine",
    "engineRevision",
    "status",
    "coverage",
    "limitations",
    "validation"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "const": "playwright-daemon"
    },
    "engineRevision": {
      "const": "45e530b7d6240abb308810183dbe4f65aae5b6dc"
    },
    "status": {
      "enum": [
        "experimental",
        "qualified"
      ]
    },
    "coverage": {
      "enum": [
        "single-payment-schedule",
        "first-listed-document",
        "all-available-invoices"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "realProvider"
      ],
      "properties": {
        "synthetic": {
          "enum": [
            "tests/engine_probe.py",
            "tests/unattended_engine_probe.py"
          ]
        },
        "realProvider": {
          "enum": [
            "not-run",
            "two-pass-qualified",
            "blocked-repeat-new-files",
            "blocked-pagination",
            "blocked-no-invoices",
            "blocked-download-transport",
            "blocked-zip-packaging"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "expectedDocuments": {
          "type": "integer",
          "minimum": 1
        },
        "firstRunNew": {
          "type": "integer",
          "minimum": 1
        },
        "repeatRunNew": {
          "type": "integer",
          "minimum": 0
        },
        "recipeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firstRunPdfReadback": {
          "type": "integer",
          "minimum": 0
        },
        "firstRunClicks": {
          "type": "integer",
          "minimum": 0
        },
        "firstRunDownloadEvents": {
          "type": "integer",
          "minimum": 0
        },
        "repeatRunClicks": {
          "type": "integer",
          "minimum": 0
        },
        "repeatRunDownloadEvents": {
          "type": "integer",
          "minimum": 0
        },
        "keySetsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independentSessions": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "required": [
              "date",
              "expectedDocuments",
              "firstRunNew",
              "repeatRunNew",
              "recipeSha256",
              "firstRunPdfReadback",
              "firstRunClicks",
              "firstRunDownloadEvents",
              "repeatRunClicks",
              "repeatRunDownloadEvents",
              "keySetsSha256",
              "independentSessions"
            ]
          }
        }
      }
    }
  ]
}
