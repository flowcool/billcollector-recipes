{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "engine",
    "engineRevision",
    "status",
    "coverage",
    "limitations",
    "validation"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "const": "playwright-daemon"
    },
    "engineRevision": {
      "enum": [
        "501898cade0b9981092db2011fb3fc02812af8b3",
        "89a89cc2c55c7dfc53ffb07acd73630621f2911b"
      ]
    },
    "status": {
      "const": "experimental"
    },
    "coverage": {
      "enum": [
        "single-payment-schedule",
        "first-listed-document",
        "offered-operation-notices"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "realProvider"
      ],
      "properties": {
        "synthetic": {
          "enum": [
            "tests/engine_probe.py",
            "tests/bourse_direct_engine_probe.py"
          ]
        },
        "realProvider": {
          "const": "not-run"
        }
      }
    },
    "scope": {
      "type": "object"
    }
  }
}
