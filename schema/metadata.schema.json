{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "product",
    "service",
    "recipeVersion",
    "status",
    "minimumRevision",
    "requiredActions",
    "authentication",
    "startUrl",
    "validation"
  ],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "service": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "recipeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["experimental", "beta", "stable", "broken", "retired"]
    },
    "minimumRevision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "requiredActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usernamePassword", "mfa"],
      "properties": {
        "usernamePassword": {"type": "boolean"},
        "mfa": {"type": "boolean"}
      }
    },
    "startUrl": {"type": "string", "format": "uri"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastTested", "scope"],
      "properties": {
        "lastTested": {"type": "string", "format": "date"},
        "scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
